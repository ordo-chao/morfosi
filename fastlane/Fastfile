default_platform(:android)

platform :android do
  desc "Distribute prebuilt Morfosi APK through Firebase App Distribution"
  lane :distribute do |options|
    release_notes = options[:release_notes] || ENV["RELEASE_NOTES"] || "Morfosi beta release"
    groups = options[:groups] || ENV["FIREBASE_TESTER_GROUPS"] || "morfosi-testers"

    # Fastlane sets Dir.pwd to the fastlane/ folder; resolve relative paths from the repo root
    repo_root = ENV["GITHUB_WORKSPACE"]
    repo_root = File.expand_path("..", __dir__) if repo_root.nil? || repo_root.empty?

    apk_path = options[:apk_path] || ENV["APK_PATH"]

    if apk_path.to_s.empty?
      app_title = (options[:app_title] || ENV["APP_TITLE"]).to_s.strip
      app_title = "Morfosi" if app_title.empty?

      raw_tag = (options[:tag] || ENV["RELEASE_TAG"] || ENV["TAG_NAME"]).to_s.strip
      UI.user_error!("Provide APK_PATH or RELEASE_TAG/TAG_NAME so the APK path can be calculated") if raw_tag.empty?

      tag_safe = raw_tag.tr("/", "-")
      apk_name = "#{app_title}-#{tag_safe}.apk"

      base_dir = File.exist?(File.join(repo_root, "android/app/build/outputs/apk/release")) ? "android/app/build/outputs/apk/release" : "app/build/outputs/apk/release"
      apk_path = File.join(base_dir, apk_name)
    end

    resolved_path = File.expand_path(apk_path, repo_root)
    UI.user_error!("APK not found at #{resolved_path}") unless File.exist?(resolved_path)

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      android_artifact_type: "APK",
      android_artifact_path: resolved_path,
      release_notes: release_notes,
      groups: groups
    )
  end
end